<Entities>

<!-- placeholder portraits (SKK) and stand-in weapons until the real ones are in -->

<!-- KP/31 SUOMI -->

    <Entity name="DOLLCOM-KP31" type="Human" editorAutoHeight="false">
        <RenderObject3D
            model="data/models/dolls/kp31.khm"
            diffuseTex="data/models/dolls/kp31.dds"
        />

        <Breakable
            template="GenericTrooperGibs"
            breakOnDamage="explosive"
            deleteOnDeath="false"
        />
        <PhysicalParams health="100" />

        <Human type="GoodGuy" unit="GFL-UNIT-DOLLCOM" class="GFL-DOLL-KP31">
            <Id
                name="DOLLCOM-KP31"
                portrait="data/textures/portraits/gfl_skkf.dds"
                gender="0"
            />
            <FOV degrees="90" distanceMeters="999" eyeRadiusMeters="1" />
            <Brain suppressionRecovery="150.0" />

            <Mobility>
                <MoveSpeed min="1.3" defaultMetersPerSec="2.6" max="10" />
                <TurnSpeed min="6" defaultMetersPerSec="16" max="20" />
            </Mobility>

            <Equipment>
                <Item name="GFL-WEAP-PPSH41" />  <!-- stand-in, GFL-WEAP-KP31 once it is finished -->
                <Item name="GFL_FeetOfGunmetal" />
                <Item name="GFL_Lockpick" />
                <Item name="GFL_BasicCore" />
                <Item name="GFL_NightVision" />
                <Item name="GFL_CombatFrame" />
            </Equipment>
        </Human>
    </Entity>

