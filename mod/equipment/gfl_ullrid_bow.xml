<Equipment>
    <Ammo name="GFL-ULLRID-BOW-ARROW"
            tooltip="@ammo_arrow_ullrid_bow_name"
            description="@ammo_arrow_ullrid_bow_desc"
            img="data/models/weapons/attachments/m855_ammo_ui.dds"
    >

        <Params
            roundsPerSecond="1.0"
            audibleSoundRadius="10"
            physicsImpactForce="2.0"
            suppressionScale="0.3"
        >
            <Damage
                start="70"
                end="55"
                startDist="0"
                endDist="100"
            />
            <CriticalChancePercent
                start="0"
                end="0"
                startDist="0"
                endDist="100"
            />
            <ArmorPenetration
                start="60"
                end="50"
                startDist="0"
                endDist="100"
            />
        </Params>
    </Ammo>

    <Firearm
        name="GFL-WEAP-ULLRID-BOW"
        inventoryBinding="SecondaryWeapon"
        category="rifle"
        unlockCost="0"
        tooltip="@WEAP-ULLRID-BOW-NAME"
        description="@WEAP-ULLRID-BOW-DESC"
        img="data/models/signatures/ak15_ui.dds"
        animationSet="gfl_ullrid_bow"
    >
        <MobilityModifiers moveSpeedModifierPercent="0" turnSpeedModifierPercent="0" />
        <ConcealmentModifier add="-4" />

        <RenderObject3D
            model="data/models/signatures/gfl_ullrid_bow.khm"
            attachSlot="prop_front_rifle"
            skipGOSSAO="true"
            diffuseTex="data/models/signatures/gfl_ullrid_bow.dds"
        />

        <ModifiableParams
            numPellets="1"
            roundsPerMagazine="1"
            closedBolt="1"
            cyclicReload="0"
            reloadTime="1333"
            reloadEmptyTime="1333"
            changeInTime="1000"
            changeOutTime="1000"
            readyTime="340"
            guardTime="160"
            accuracyStart="85"
            accuracyEnd="80"
            accuracyStartDist="4"
            accuracyEndDist="50"
            suppressArea="0"
            meleeDamageBonus="100"
        />

        <Params
            caliberInfoText="@firearm_caliber_arrow_name"
            operationInfoText="@firearm_operation_bow_name"
            ai_rangeMin="1.0"
            ai_rangeOptimal="12.0"
            ai_rangeMax="30.0"
        />

        <AttackTypes>

            <AttackType name="GFL_CQC_ULLRID_BOW" rangeMeters="4" />
            <AttackType name="GFL_Near_ULLRID_BOW" rangeMeters="8" />
            <AttackType name="GFL_Close_ULLRID_BOW" rangeMeters="12" />
            <AttackType name="GFL_Medium_ULLRID_BOW" rangeMeters="16" />
            <AttackType name="GFL_MedEdge_ULLRID_BOW" rangeMeters="20" />
            <AttackType name="GFL_Extended_ULLRID_BOW" rangeMeters="9999" />

        </AttackTypes>


        <MuzzleFlash tracerTemplate="Tracer_Rifle"/>

        <Sounds>
            <Equip name="rifle_eqp" />
            <Unequip name="rifle_neqp" />
            <Reload name="gfl_ullrid_bow_reld" />
            <ReloadEmpty name="gfl_ullrid_bow_reld" />
            <Fire name="gfl_ullrid_bow_fire" />
            <Empty name="gen_empty" />
        </Sounds>
    </Firearm>

	<Bind eqp="GFL-WEAP-ULLRID-BOW">
		<to name="GFL-ULLRID-BOW-ARROW" />
		<to name="scope_GFL_IronSights" />
	</Bind>
</Equipment>
